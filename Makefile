## Location to install dependencies to
LOCALBIN ?= $(shell pwd)/bin
$(LOCALBIN):
	mkdir -p $(LOCALBIN)

# CONTAINER_TOOL defines the container tool to be used for building images.
CONTAINER_TOOL ?= docker

# Commit of openeverest/openeverest pinned in go.mod (a tag or a pseudo-version).
# CI builds the OpenEverest controller from it. Override it (e.g.
# OPENEVEREST_REF=main) to build against another core ref.
OPENEVEREST_REF ?= $(shell sed -n 's/.*"Hash":"\([0-9a-f]*\)".*/\1/p' \
	"$$(go mod download -json github.com/openeverest/openeverest/v2 | sed -n 's/.*"Info": "\(.*\)",/\1/p')")

# Local checkout of openeverest/openeverest (at OPENEVEREST_REF) used to build
# and deploy the OpenEverest controller for integration tests.
OPENEVEREST_DIR ?= _openeverest

# Image URL to use for building/pushing image targets
IMG ?= ghcr.io/openeverest/provider-mariadb-dev:latest

# Image URL for OpenEverest controller used in integration tests (must be pre-built).
OPENEVEREST_CONTROLLER_IMG ?= ghcr.io/openeverest/openeverest-controller-dev:0.0.0

# Split IMG into repository and tag for Helm values
_IMG_REPO = $(firstword $(subst :, ,$(IMG)))
_IMG_TAG  = $(lastword $(subst :, ,$(IMG)))

# k3d cluster name (must match dev/k3d_config.yaml metadata.name)
K3D_CLUSTER_NAME ?= provider-mariadb-test

# controller-gen version
CONTROLLER_TOOLS_VERSION ?= v0.18.0
CONTROLLER_GEN ?= $(LOCALBIN)/controller-gen-$(CONTROLLER_TOOLS_VERSION)

# yq version for YAML processing
YQ_VERSION ?= v4.44.6
YQ ?= $(LOCALBIN)/yq-$(YQ_VERSION)

# golangci-lint version
GOLANGCI_LINT_VERSION ?= v2.13.2
GOLANGCI_LINT ?= $(LOCALBIN)/golangci-lint-$(GOLANGCI_LINT_VERSION)

# Helm chart directory
CHART_DIR ?= charts/provider-mariadb

.PHONY: help
help: ## Display this help.
	@awk 'BEGIN {FS = ":.*##"; printf "\nUsage:\n  make \033[36m<target>\033[0m\n"} /^[a-zA-Z_0-9-]+:.*?##/ { printf "  \033[36m%-20s\033[0m %s\n", $$1, $$2 } /^##@/ { printf "\n\033[1m%s\033[0m\n", substr($$0, 5) } ' $(MAKEFILE_LIST)

##@ Development

.PHONY: run
run: generate ## Run the provider locally, without the admission webhook (it needs the chart's certificate).
	go run cmd/provider/main.go --admission=false

.PHONY: lint
lint: golangci-lint ## Run golangci-lint.
	$(GOLANGCI_LINT) run

.PHONY: test-unit
test-unit: ## Run unit tests.
	go test -race ./... -coverprofile cover.out

##@ Code Generation

.PHONY: manifests
manifests: controller-gen ## Generate RBAC manifests using controller-gen from kubebuilder markers.
	$(CONTROLLER_GEN) rbac:roleName=manager-role paths="./..." output:rbac:dir=config/rbac
	@{ \
		echo '# This file is generated by controller-gen from kubebuilder RBAC markers.'; \
		echo '# Do not edit manually. Run `make manifests` to regenerate.'; \
		echo '#'; \
		echo '# Source markers are in internal/provider/rbac.go and other .go files'; \
		echo '# with +kubebuilder:rbac annotations.'; \
		if grep -q '^---' config/rbac/role.yaml; then sed -n '/^---/,$$p' config/rbac/role.yaml; else cat config/rbac/role.yaml; fi; \
	} > config/rbac/role.yaml.tmp
	@mv config/rbac/role.yaml.tmp config/rbac/role.yaml

.PHONY: helm-sync-rbac
helm-sync-rbac: yq ## Sync generated RBAC rules into the Helm chart.
	@echo "Syncing RBAC rules from config/rbac/role.yaml to Helm chart..."
	@{ \
		echo '# This file is generated by `make helm-sync-rbac` from config/rbac/role.yaml.'; \
		echo '# Do not edit manually. Run `make generate` to update.'; \
		$(YQ) '.rules' config/rbac/role.yaml; \
	} > $(CHART_DIR)/generated/rbac-rules.yaml
	@echo "Done."

# mariadb-operator Helm repository and the version of the bundled operator
# subchart; the operator CRDs are vendored at the same version.
MARIADB_OPERATOR_HELM_REPO ?= https://mariadb-operator.github.io/mariadb-operator
MARIADB_OPERATOR_VERSION = $(shell $(YQ) '.dependencies[] | select(.name == "mariadb-operator") | .version' $(CHART_DIR)/Chart.yaml)

.PHONY: helm-sync-operator-crds
helm-sync-operator-crds: yq ## Vendor the mariadb-operator CRDs into the Helm chart, annotated to survive helm uninstall.
	@echo "Syncing mariadb-operator CRDs $(MARIADB_OPERATOR_VERSION) into the Helm chart..."
	@set -e; tmp=$$(mktemp -d); trap 'rm -rf "$$tmp"' EXIT; \
	helm pull mariadb-operator-crds --repo $(MARIADB_OPERATOR_HELM_REPO) \
		--version "$(MARIADB_OPERATOR_VERSION)" --untar --untardir "$$tmp"; \
	{ \
		echo '# This file is generated by `make helm-sync-operator-crds` from the'; \
		echo '# mariadb-operator-crds chart $(MARIADB_OPERATOR_VERSION) (the version of the operator subchart).'; \
		echo '# Do not edit manually. Run `make generate` to update.'; \
		$(YQ) '.metadata.annotations["helm.sh/resource-policy"] = "keep"' "$$tmp/mariadb-operator-crds/templates/crds.yaml"; \
	} > $(CHART_DIR)/generated/operator-crds.yaml
	@echo "Done."

.PHONY: generate
generate: manifests helm-sync-rbac helm-sync-operator-crds ## Run all code generation (RBAC, operator CRDs + Helm sync, provider spec from definition/).
	go generate ./...
	@echo "All generation complete."

.PHONY: verify
verify: ## Verify that generated files are up-to-date (for CI).
	@$(MAKE) generate
	@if git diff --quiet -- config/ definition/ $(CHART_DIR)/generated/; then \
		echo "Generated files are up-to-date."; \
	else \
		echo "ERROR: Generated files are out of date. Run 'make generate' and commit the changes."; \
		git diff -- config/ definition/ $(CHART_DIR)/generated/; \
		exit 1; \
	fi

##@ Build

.PHONY: build
build: generate ## Build provider binary.
	go build -o bin/provider cmd/provider/main.go

.PHONY: docker-build
docker-build: ## Build docker image.
	$(CONTAINER_TOOL) build -t ${IMG} .

.PHONY: build-linux
build-linux: generate ## Cross-compile provider binary for Linux (dev image).
	CGO_ENABLED=0 GOOS=linux GOARCH=$(shell go env GOARCH) go build -o bin/provider cmd/provider/main.go

.PHONY: docker-build-dev
docker-build-dev: build-linux ## Build dev image (expects linux bin/provider in context).
	$(CONTAINER_TOOL) build -f dev/provider.Dockerfile -t ${IMG} .

.PHONY: docker-push
docker-push: ## Push docker image.
	$(CONTAINER_TOOL) push ${IMG}

##@ Helm

.PHONY: helm-deps
helm-deps: ## Download/update Helm chart dependencies.
	helm dependency build $(CHART_DIR)

.PHONY: helm-install
helm-install: helm-deps ## Install the provider using Helm.
	helm install provider-mariadb $(CHART_DIR) --create-namespace

.PHONY: helm-upgrade
helm-upgrade: helm-deps ## Upgrade the provider using Helm.
	helm upgrade provider-mariadb $(CHART_DIR)

.PHONY: helm-uninstall
helm-uninstall: ## Uninstall the provider using Helm.
	helm uninstall provider-mariadb

.PHONY: helm-template
helm-template: helm-deps ## Render Helm chart templates locally (dry-run).
	helm template provider-mariadb $(CHART_DIR)

##@ Testing

# Integration tests use chainsaw (https://kyverno.github.io/chainsaw/).
# Install it locally with: go install github.com/kyverno/chainsaw@latest
# Each suite is a directory under test/integration/ — see test/integration/README.md.

.PHONY: test-integration
test-integration: ## Run all integration tests against the current cluster.
	. ./test/vars.sh && chainsaw test --config ./test/integration/.chainsaw.yaml ./test/integration

.PHONY: test-integration-core
test-integration-core: ## Run core integration tests.
	. ./test/vars.sh && chainsaw test --config ./test/integration/.chainsaw.yaml ./test/integration/core

.PHONY: test-integration-core-admission
test-integration-core-admission: ## Run admission webhook integration tests.
	. ./test/vars.sh && chainsaw test --config ./test/integration/.chainsaw.yaml ./test/integration/core/admission

.PHONY: test-integration-monitoring
test-integration-monitoring: ## Run MonitoringBinding (spec.monitoring.destinations) integration tests.
	. ./test/vars.sh && chainsaw test --config ./test/integration/.chainsaw.yaml ./test/integration/monitoring

.PHONY: test-integration-galera
test-integration-galera: ## Run Galera HA integration tests.
	. ./test/vars.sh && chainsaw test --config ./test/integration/.chainsaw.yaml ./test/integration/galera

.PHONY: test-integration-replication
test-integration-replication: ## Run async replication HA integration tests.
	. ./test/vars.sh && chainsaw test --config ./test/integration/.chainsaw.yaml ./test/integration/replication

.PHONY: test-integration-maxscale
test-integration-maxscale: ## Run MaxScale proxy integration tests.
	. ./test/vars.sh && chainsaw test --config ./test/integration/.chainsaw.yaml ./test/integration/maxscale

.PHONY: test-integration-backup
test-integration-backup: ## Run physical and logical backup/restore integration tests (deploys SeaweedFS).
	. ./test/vars.sh && chainsaw test --config ./test/integration/.chainsaw.yaml ./test/integration/backup

.PHONY: test-integration-tls
test-integration-tls: ## Run TLS (spec.parameters.tls) integration tests (installs cert-manager when absent).
	. ./test/vars.sh && chainsaw test --config ./test/integration/.chainsaw.yaml ./test/integration/tls

.PHONY: test-integration-pitr
test-integration-pitr: ## Run point-in-time recovery integration tests (deploys SeaweedFS).
	. ./test/vars.sh && chainsaw test --config ./test/integration/.chainsaw.yaml ./test/integration/pitr

.PHONY: test-integration-reinstall
test-integration-reinstall: ## Run the uninstall/reinstall integration test (uninstalls and reinstalls the provider chart).
	. ./test/vars.sh && chainsaw test --config ./test/integration/.chainsaw.yaml ./test/integration/reinstall

.PHONY: load-image
load-image: ## Import the provider image (IMG) into the k3d cluster.
	k3d image import ${IMG} -c ${K3D_CLUSTER_NAME}

.PHONY: load-openeverest-controller-image
load-openeverest-controller-image: ## Import the OpenEverest controller image into the k3d cluster.
	k3d image import ${OPENEVEREST_CONTROLLER_IMG} -c ${K3D_CLUSTER_NAME}

.PHONY: openeverest-ref
openeverest-ref: ## Print the openeverest/openeverest ref to build the OpenEverest controller from (OPENEVEREST_REF).
	@test -n "$(OPENEVEREST_REF)" || { echo "cannot resolve the openeverest/openeverest commit pinned in go.mod" >&2; exit 1; }
	@echo $(OPENEVEREST_REF)

.PHONY: openeverest-checkout
openeverest-checkout: ## Check out openeverest/openeverest at OPENEVEREST_REF into OPENEVEREST_DIR.
	@ref="$(OPENEVEREST_REF)"; \
	test -n "$$ref" || { echo "cannot resolve the openeverest/openeverest commit pinned in go.mod" >&2; exit 1; }; \
	if [ ! -d "$(OPENEVEREST_DIR)/.git" ]; then \
		git init -q "$(OPENEVEREST_DIR)"; \
		git -C "$(OPENEVEREST_DIR)" remote add origin https://github.com/openeverest/openeverest; \
	fi; \
	git -C "$(OPENEVEREST_DIR)" fetch --depth 1 origin "$$ref"; \
	git -C "$(OPENEVEREST_DIR)" checkout --force FETCH_HEAD

.PHONY: install-crds
install-crds: ## Install OpenEverest CRDs (and your operator's CRDs) into the cluster.
	go mod download github.com/openeverest/openeverest/v2
	kubectl apply --server-side --force-conflicts -f "$$(go list -m -f '{{.Dir}}' github.com/openeverest/openeverest/v2)/config/crd/bases"
	kubectl wait --for condition=established --timeout=30s crd/backupstorageclasses.backup.openeverest.io
	kubectl apply -f "$$(go list -m -f '{{.Dir}}' github.com/openeverest/openeverest/v2)/config/backupstorageclasses/s3.yaml"
	# TODO: install your operator's CRDs, e.g.:
	# curl -fsSL https://raw.githubusercontent.com/<org>/<operator>/v$(OPERATOR_VERSION)/deploy/crd.yaml | kubectl apply --server-side -f -

.PHONY: deploy-provider-ci
deploy-provider-ci: helm-deps ## Deploy the provider via Helm for CI (IMG must already be imported into k3d).
	# TODO: if your chart pulls dependencies from external repos, add them first:
	# helm repo add <repo-name> <repo-url>
	helm upgrade --install provider-mariadb $(CHART_DIR) \
		--create-namespace \
		--namespace provider-system \
		--set image.repository=$(_IMG_REPO) \
		--set image.tag=$(_IMG_TAG) \
		--set image.pullPolicy=Never \
		--wait --timeout 5m
	# TODO: if your chart bundles the DB operator as a subchart, scale it to 0
	# (e.g. --set operator.replicaCount=0) — integration tests simulate the
	# operator by patching CR statuses directly.

##@ Local Development Cluster

.PHONY: k3d-cluster-up
k3d-cluster-up: ## Create a local k3d cluster for development.
	$(info Creating k3d cluster for testing)
	k3d cluster create --config ./dev/k3d_config.yaml

.PHONY: k3d-cluster-down
k3d-cluster-down: ## Delete the local k3d cluster.
	$(info Destroying k3d test cluster)
	k3d cluster delete --config ./dev/k3d_config.yaml

.PHONY: k3d-cluster-reset
k3d-cluster-reset: k3d-cluster-down k3d-cluster-up ## Reset the local k3d cluster.

##@ Tilt Development

.PHONY: dev-up
dev-up: k3d-cluster-up ## Create the k3d cluster and start the Tilt dev environment.
	tilt up -f dev/Tiltfile

.PHONY: dev-down
dev-down: ## Stop the Tilt dev environment (keeps the cluster).
	tilt down -f dev/Tiltfile

.PHONY: dev-destroy
dev-destroy: k3d-cluster-down ## Stop Tilt and delete the k3d cluster.

##@ Tool Dependencies

.PHONY: controller-gen
controller-gen: $(CONTROLLER_GEN) ## Install controller-gen.
$(CONTROLLER_GEN): $(LOCALBIN)
	$(call go-install-tool,$(CONTROLLER_GEN),sigs.k8s.io/controller-tools/cmd/controller-gen,$(CONTROLLER_TOOLS_VERSION))

.PHONY: yq
yq: $(YQ) ## Install yq.
$(YQ): $(LOCALBIN)
	@echo "Installing yq $(YQ_VERSION)..."
	@GOBIN=$(LOCALBIN) go install github.com/mikefarah/yq/v4@$(YQ_VERSION) && mv $(LOCALBIN)/yq $(YQ)

.PHONY: golangci-lint
golangci-lint: $(GOLANGCI_LINT) ## Install golangci-lint.
$(GOLANGCI_LINT): $(LOCALBIN)
	$(call go-install-tool,$(GOLANGCI_LINT),github.com/golangci/golangci-lint/v2/cmd/golangci-lint,$(GOLANGCI_LINT_VERSION))

# go-install-tool will 'go install' any package with custom target and target name. Usage:
# $(call go-install-tool,<target>,<package>,<version>)
define go-install-tool
@[ -f $(1) ] || { \
set -e; \
package=$(2)@$(3); \
echo "Installing $${package}"; \
GOBIN=$(LOCALBIN) go install $${package}; \
mv -f $$(echo "$(1)" | sed "s/-$(3)$$//") $(1); \
}
endef
